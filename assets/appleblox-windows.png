<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Appleblox for Windows</title>
    <style>
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: radial-gradient(ellipse at 50% 45%, #14142a 0%, #080812 70%, #030308 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            overflow-x: hidden;
        }

        .logo-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            padding: 40px;
            position: relative;
        }

        .logo-svg-wrapper {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .logo-svg-wrapper::before {
            content: '';
            position: absolute;
            width: 520px;
            height: 520px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(30, 140, 255, .30) 0%, rgba(30, 140, 255, .12) 45%, transparent 75%);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 0;
            pointer-events: none;
        }

        .logo-svg-wrapper svg {
            position: relative;
            z-index: 1;
            width: min(480px, 82vw);
            height: auto;
            display: block;
        }

        .brand-name {
            font-size: clamp(38px, 6vw, 58px);
            font-weight: 800;
            color: #ffffff;
            text-align: center;
            letter-spacing: -1px;
            line-height: 1.1;
            text-shadow: 0 2px 20px rgba(30, 140, 255, .25);
            margin-top: 8px;
        }

        .brand-subtitle {
            font-size: clamp(12px, 1.5vw, 15px);
            font-weight: 500;
            color: rgba(255, 255, 255, .55);
            text-align: center;
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-top: -4px;
            padding-bottom: 12px;
            position: relative;
        }

        .brand-subtitle::after {
            content: '';
            display: block;
            width: 60px;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(30, 140, 255, .6), transparent);
            margin: 10px auto 0;
        }
    </style>
</head>
<body>

    <div class="logo-container">
        <div class="logo-svg-wrapper">
            <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <!-- Apple body gradient -->
                    <radialGradient id="appleGrad" cx="38%" cy="28%" r="75%">
                        <stop offset="0%" stop-color="#ffffff"/>
                        <stop offset="45%" stop-color="#f2f2f2"/>
                        <stop offset="100%" stop-color="#c8c8c8"/>
                    </radialGradient>

                    <!-- Windows symbol gradient -->
                    <linearGradient id="winGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#42A5F5"/>
                        <stop offset="40%" stop-color="#1E88E5"/>
                        <stop offset="100%" stop-color="#0D47A1"/>
                    </linearGradient>

                    <!-- Apple drop shadow -->
                    <filter id="appleShadow" x="-20%" y="-20%" width="140%" height="140%">
                        <feDropShadow dx="0" dy="4" stdDeviation="12" flood-color="#000000" flood-opacity="0.45"/>
                    </filter>

                    <!-- Windows symbol shadow -->
                    <filter id="winShadow" x="-30%" y="-30%" width="160%" height="160%">
                        <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#000000" flood-opacity="0.35"/>
                    </filter>
                </defs>

                <!-- Apple body with bite on the right -->
                <path d="M250,90
                         C290,80 340,100 350,160
                         C355,180 352,200 338,212
                         C312,228 300,242 316,258
                         C330,272 340,288 334,312
                         C328,342 290,380 250,380
                         C210,380 170,360 160,320
                         C150,280 140,220 150,160
                         C160,100 210,80 250,90Z"
                      fill="url(#appleGrad)" stroke="#e0e0e0" stroke-width="0.8" filter="url(#appleShadow)"/>

                <!-- Apple highlight sheen -->
                <ellipse cx="210" cy="190" rx="58" ry="80" fill="white" opacity="0.18"/>

                <!-- Stem -->
                <path d="M250,88 C248,70 242,52 255,32" stroke="#5D4037" stroke-width="5" fill="none" stroke-linecap="round"/>

                <!-- Stem base highlight -->
                <path d="M250,88 C248,70 242,52 255,32" stroke="#8D6E63" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.4"/>

                <!-- Leaf -->
                <g transform="rotate(-20 268 52)">
                    <ellipse cx="268" cy="52" rx="22" ry="9" fill="#43A047"/>
                    <ellipse cx="268" cy="52" rx="22" ry="9" fill="url(#leafGrad)" opacity="0.5"/>
                    <path d="M255,52 C262,50 275,50 285,52" stroke="#1B5E20" stroke-width="1" fill="none" opacity="0.6"/>
                </g>

                <!-- Windows symbol (four panes) -->
                <g filter="url(#winShadow)">
                    <rect x="205" y="186" width="39" height="39" rx="4" fill="url(#winGrad)"/>
                    <rect x="249" y="186" width="39" height="39" rx="4" fill="url(#winGrad)"/>
                    <rect x="205" y="230" width="39" height="39" rx="4" fill="url(#winGrad)"/>
                    <rect x="249" y="230" width="39" height="39" rx="4" fill="url(#winGrad)"/>
                </g>

                <!-- Windows symbol inner highlight -->
                <rect x="205" y="186" width="39" height="39" rx="4" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="0.5"/>
                <rect x="249" y="186" width="39" height="39" rx="4" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="0.5"/>
                <rect x="205" y="230" width="39" height="39" rx="4" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="0.5"/>
                <rect x="249" y="230" width="39" height="39" rx="4" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="0.5"/>
            </svg>
        </div>

        <div class="brand-name">Appleblox</div>
        <div class="brand-subtitle">For Windows</div>
    </div>

</body>
</html>
